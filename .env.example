# Environment Configuration for Voice AI Decision System

# Application Environment
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info

# Service Ports
API_PORT=3000
AI_SERVICE_PORT=8000
NGINX_PORT=80
NGINX_SSL_PORT=443

# CORS Configuration
CORS_ORIGIN=*

# File Upload Configuration
MAX_FILE_SIZE=50MB
MAX_AUDIO_SIZE=52428800

# AI Model Configuration
WHISPER_MODEL=base
LLM_MODEL=Qwen/Qwen2-1.5B-Instruct
DEVICE=cpu

# Processing Configuration
MAX_CONCURRENT_TASKS=2
TASK_TIMEOUT=300

# Resource Limits
AI_MEMORY_LIMIT=4G
AI_MEMORY_RESERVATION=2G
AI_CPU_LIMIT=2.0
AI_CPU_RESERVATION=1.0

# Development Override (copy to .env.local for development)
# NODE_ENV=development
# DEBUG=true
# LOG_LEVEL=debug
# MAX_CONCURRENT_TASKS=1
# AI_MEMORY_LIMIT=2G
# AI_MEMORY_RESERVATION=1G