# Application settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model settings
WHISPER_MODEL=base
LLM_MODEL=Qwen/Qwen2-1.5B-Instruct
DEVICE=cpu

# Vector database settings
VECTOR_DB_PATH=./vector_db
VECTOR_DB_COLLECTION=knowledge_base

# File settings
MAX_AUDIO_SIZE=52428800
SUPPORTED_AUDIO_FORMATS=["wav", "mp3", "m4a", "flac"]

# Processing settings
MAX_CONCURRENT_TASKS=4
TASK_TIMEOUT=300