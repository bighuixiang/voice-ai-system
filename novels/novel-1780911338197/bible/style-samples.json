    ],
    "useCase": "combat",
    "excerpt": "\u7956\u5e08\u6b8b\u5ff5\u4e0a\u8eab\u7684\u77ac\u95f4\uff0c\u9053\u4eba\u80cc\u540e\u7684\u5149\u5f71\u5e76\u6ca1\u6709\u7acb\u523b\u62d4\u9ad8\uff0c\u800c\u662f\u5148\u8ba9\u6574\u5ea7\u4e5d\u83b2\u5b9d\u5c71\u7684\u98ce\u505c\u4e86\u4e00\u606f\u3002\u4e0b\u4e00\u523b\uff0c\u4e91\u6d77\u5012\u5377\uff0c\u5c71\u810a\u5982\u9f99\uff0c\u6210\u5343\u4e0a\u4e07\u9053\u9635\u7eb9\u4ece\u5cf0\u9876\u53cd\u538b\u800c\u8d77\uff0c\u4eff\u4f5b\u6709\u4eba\u7528\u53cc\u624b\u628a\u6574\u7247\u5929\u7a79\u5f80\u4e0b\u6309\u4e86\u4e09\u5bf8\u3002\u5c06\u81e3\u53ea\u62ac\u4e86\u4e00\u4e0b\u773c\uff0c\u5c38\u6c14\u4fbf\u5982\u9ed1\u6d6a\u649e\u8fdb\u9635\u5fc3\uff0c\u78b0\u5f97\u534a\u5ea7\u5c71\u5d16\u5f53\u573a\u5d29\u88c2\uff0c\u800c\u62a4\u9635\u957f\u8001\u81c2\u9aa8\u4e5f\u5728\u53cd\u9707\u4e2d\u4e00\u5bf8\u5bf8\u88c2\u5f00\u3002"
  },
  {
    "id": "mystery-jade-pendant-trace",
    "tags": [
