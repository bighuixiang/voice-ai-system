{
  "voiceRules": [
    "\u5f00\u7bc7\u9996\u5c4f\u5fc5\u987b\u5148\u843d\u5f02\u8c61\u3001\u538b\u529b\u3001\u4f4d\u9636\u4e0e\u4e3b\u89d2\u5904\u5883\uff0c\u518d\u8865\u80cc\u666f\u3002",
    "\u4e1c\u65b9\u7384\u5e7b\u7684\u6c14\u52bf\u8981\u901a\u8fc7\u5c71\u6cb3\u3001\u9635\u52bf\u3001\u6cd5\u76f8\u3001\u8840\u4ef7\u548c\u4f17\u4eba\u53cd\u5e94\u843d\u5730\uff0c\u4e0d\u80fd\u53ea\u9760\u7a7a\u6cdb\u62d4\u9ad8\u3002",
    "\u5c06\u81e3\u8fd9\u7c7b\u89d2\u8272\u7684\u538b\u8feb\u611f\u5fc5\u987b\u7531\u505c\u987f\u3001\u76ee\u5149\u3001\u9519\u89c9\u3001\u5c38\u6c14\u3001\u73af\u5883\u53cd\u9988\u548c\u4ed6\u4eba\u5931\u63a7\u6765\u4f53\u73b0\uff0c\u4e0d\u8981\u76f4\u63a5\u89e3\u91ca\u201c\u4ed6\u5f88\u5f3a\u201d\u3002",
    "\u4e3b\u89d2\u7684\u4ef7\u503c\u4e0d\u662f\u8e72\u5728\u89e3\u8bf4\u91cc\uff0c\u800c\u662f\u5728\u88ab\u538b\u8feb\u65f6\u8fd8\u505a\u51fa\u9009\u62e9\uff0c\u5e76\u4e3a\u9009\u62e9\u4ed8\u51fa\u4ef7\u683c\u3002",
    "\u7389\u4f69\u3001\u5c01\u5370\u3001\u5e08\u7236\u3001\u7a7f\u8d8a\u7b49\u4f0f\u7b14\u8981\u901a\u8fc7\u80fd\u770b\u89c1\u3001\u80fd\u8ffd\u8e2a\u7684\u75d5\u8ff9\u91cd\u590d\u51fa\u73b0\uff0c\u4e0d\u8981\u4e00\u6b21\u6027\u89e3\u91ca\u5b8c\u3002"
  ],
  "antiPatterns": [
    "\u4e0d\u8981\u4ee5\u7a7a\u6cdb\u5929\u5730\u63cf\u5199\u6216\u5927\u6bb5\u8bbe\u5b9a\u8bb2\u89e3\u5f00\u7bc7\u3002",
    "\u4e0d\u8981\u7528\u603b\u7ed3\u5f0f\u60c5\u7eea\u53e5\u53d6\u4ee3\u80a2\u4f53\u3001\u547c\u5438\u3001\u89c6\u89c9\u3001\u75bc\u75db\u6216\u7f9e\u8fb1\u53cd\u5e94\u3002",
    "\u4e0d\u8981\u628a\u5b97\u95e8\u957f\u8001\u6216\u5343\u5e74\u5e03\u5c40\u5199\u6210\u614c\u4e71\u65e0\u5907\uff0c\u9664\u975e\u6587\u4e2d\u5148\u4ea4\u4ee3\u51fa\u660e\u786e\u5931\u8bef\u6216\u66f4\u5927\u5c42\u7ea7\u7684\u6253\u51fb\u3002",
    "\u4e0d\u8981\u8ba9\u5927\u6218\u53ea\u5269\u62db\u5f0f\u540d\u79f0\u548c\u60ca\u53f9\uff0c\u4e0d\u89c1\u5730\u5f62\u7834\u574f\u3001\u6cd5\u9635\u53cd\u632f\u6216\u4eba\u7269\u4ef7\u683c\u3002",
    "\u4e0d\u8981\u7528\u201c\u8fd9\u4ec5\u4ec5\u662f\u5f00\u59cb\u201d\u4e4b\u7c7b\u5047\u60ac\u5ff5\u53e5\u6536\u5c3e\uff0c\u8981\u7528\u5177\u4f53\u540e\u679c\u3001\u65b0\u503a\u6216\u65b0\u5371\u673a\u7ed3\u675f\u3002"
  ],
  "sceneContracts": {
    "chapterOpening": [
      "\u5f00\u573a\u4e09\u6bb5\u5185\u5fc5\u987b\u51fa\u73b0\uff1a\u5f02\u8c61\u6216\u94c3\u62a5\uff0c\u9547\u538b\u9635\u8425\u6216\u5b97\u95e8\u79e9\u5e8f\uff0c\u4e3b\u89d2\u88ab\u5377\u5165\u7684\u5371\u5883\u3002",
      "\u5982\u679c\u662f\u5c71\u95e8\u3001\u7981\u5730\u3001\u5c01\u5370\u4e4b\u5730\uff0c\u8981\u5148\u5199\u51fa\u5b83\u5df2\u7ecf\u8fd0\u8f6c\u5343\u5e74\u7684\u79e9\u5e8f\u548c\u5e03\u7f6e\uff0c\u518d\u5199\u5371\u673a\u600e\u6837\u8d85\u51fa\u9884\u6848\u3002"
    ],
    "combat": [
      "\u7956\u5e08\u4e0a\u8eab\u3001\u6cd5\u76f8\u6216\u9635\u52bf\u7206\u53d1\u65f6\uff0c\u5fc5\u987b\u51fa\u73b0\u5c71\u4f53\u3001\u4e91\u5c42\u3001\u6cb3\u9053\u3001\u5c71\u95e8\u3001\u9635\u7eb9\u6216\u661f\u5149\u7684\u540c\u6b65\u5f02\u53d8\u3002",
      "\u6218\u6597\u5fc5\u987b\u8ba9\u654c\u6211\u5224\u65ad\u53d1\u751f\u53d8\u5316\uff1a\u4ee5\u4e3a\u80fd\u5c01\u4f4f\uff0c\u53d1\u73b0\u5c01\u4e0d\u4f4f\uff1b\u4ee5\u4e3a\u80fd\u6321\u4f4f\uff0c\u7ed3\u679c\u53ea\u662f\u62d6\u5ef6\u3002",
      "\u4e3b\u89d2\u5165\u573a\u65f6\u4e0d\u7ba1\u5f3a\u5f31\uff0c\u90fd\u8981\u6709\u53ef\u89c1\u7684\u4ed8\u51fa\uff1a\u5410\u8840\u3001\u65ad\u9aa8\u3001\u5bff\u5143\u3001\u9635\u773c\u53cd\u566c\u3001\u7389\u4f69\u707c\u70e7\u3001\u8bb0\u5fc6\u523a\u75db\u7b49\u3002"
    ],
    "chapterEnding": [
      "\u7ae0\u672b\u8981\u843d\u5728\u540e\u679c\u4e0a\uff1a\u5cf0\u5d29\u3001\u4eba\u6b7b\u3001\u9635\u7834\u3001\u5370\u8bb0\u663e\u9732\u3001\u654c\u4eba\u7559\u75d5\u3001\u4e3b\u89d2\u80cc\u8d1f\u65b0\u503a\u3002",
      "\u7389\u4f69\u3001\u5e08\u7236\u62fe\u5230\u4e3b\u89d2\u65f6\u5df2\u7ecf\u6302\u5728\u8136\u5b50\u4e0a\uff0c\u8fd9\u4e2a\u4fe1\u606f\u4e0d\u8981\u4e00\u6b21\u6027\u8bf4\u900f\uff0c\u800c\u8981\u5206\u6210\u591a\u6b21\u53ef\u56de\u770b\u7684\u75d5\u8ff9\u548c\u8ffd\u95ee\u3002"
    ]
  }
}
